{
  "name": "ausbildung-nepal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Honest, sourced information for Nepali students about vocational training (Ausbildung) in Germany.",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "check-links": "eleventy && node scripts/check-links.mjs --dir _site",
    "check-watch": "node scripts/check-watch.mjs",
    "check-figures": "node scripts/check-figures.mjs",
    "check-translations": "node scripts/check-translations.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  }
}
