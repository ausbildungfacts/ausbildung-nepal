{#- Which language this page is, and the strings and collections that follow
    from it. Set once here so no block further down has to ask again.

    "lang" comes from src/ne/ne.json for every page in that folder, so a Nepali
    page cannot forget to declare itself. Everything else defaults to English.

    "tr" is this page's entry in the translation register built by
    src/_data/translations.js: whether a counterpart exists, and whether it has
    drifted behind the English. -#}
{%- set L = lang or "en" %}
{%- set S = ui[L] %}
{%- set menu = collections.pages_ne if L == "ne" else collections.pages_en %}
{%- set tr = translations.byNe[page.url] if L == "ne" else translations.byEn[page.url] %}
<!doctype html>
<html lang="{{ L }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ S.siteTitle }}</title>
<meta name="description" content="{{ description }}">
{#- Tells a search engine that the English and Nepali pages are the same page
    in two languages, rather than two pages competing for the same reader.
    Without this pair a translated mirror reads as duplicate content.

    x-default points at the English, because that is the version this site
    treats as authoritative and the one that always exists. -#}
{%- if L == "ne" and tr and tr.enUrl %}
<link rel="alternate" hreflang="ne" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ tr.enUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ tr.enUrl }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- elif L == "en" and tr and tr.neUrl %}
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="ne" href="{{ site.url }}{{ tr.neUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
{%- if noindex %}
{#- Pages that carry the operator's name and home address. They stay public and
    fully readable — German law requires that — but they are kept out of search
    results. The page must stay crawlable for this tag to be seen at all, so it
    is NOT blocked in robots.txt: a blocked page can still be listed as a bare
    URL, because the crawler never gets to read the instruction not to. #}
<meta name="robots" content="noindex, follow">
{%- endif %}
<style>
  :root {
    --bg: #FBFAF8;
    --surface: #FFFFFF;
    --ink: #1A1D21;
    --ink-soft: #545C64;
    --line: #DFDCD6;
    --accent: #1D5C4F;
    --accent-soft: #E4EFEB;
    --warn: #8A4B12;
    --warn-soft: #F8EFE3;
    --max: 40rem;
    /* The "leaves this site" arrow. Inline SVG so it costs no request and
       cannot fail to load on a slow connection. Colour comes from the mask, so
       this shape is defined once and works in both themes. */
    --ext-arrow: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12"><path d="M3.2 1.6h7.2v7.2H8.8V4.33L2.33 10.8 1.2 9.67 7.67 3.2H3.2z" fill="black"/></svg>');
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14171A;
      --surface: #1C2024;
      --ink: #E9ECEF;
      --ink-soft: #A2ABB3;
      --line: #2E343A;
      --accent: #6FBFA8;
      --accent-soft: #172C27;
      --warn: #D9A263;
      --warn-soft: #2A2118;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14171A;
    --surface: #1C2024;
    --ink: #E9ECEF;
    --ink-soft: #A2ABB3;
    --line: #2E343A;
    --accent: #6FBFA8;
    --accent-soft: #172C27;
    --warn: #D9A263;
    --warn-soft: #2A2118;
  }
  * { box-sizing: border-box; }
  body {
    background: var(--bg);
    color: var(--ink);
    /* Sans-serif throughout: this is read on cheap Android phones in a second
       language, and a humanist sans is measurably easier going than Georgia. */
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    margin: 0;
    padding: 0 1.15rem 4rem;
    -webkit-text-size-adjust: 100%;
  }
  .wrap { max-width: var(--max); margin: 0 auto; }
  header.site {
    padding: 1.4rem 0 1.3rem;
    border-bottom: 2px solid var(--accent);
    margin-bottom: 2rem;
  }
  header.site a.brand {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -.01em;
    color: var(--ink);
    text-decoration: none;
    display: block;
    line-height: 1.25;
  }
  header.site a.brand .brand-sub {
    display: block;
    font-weight: 400;
    font-size: .9375rem;
    color: var(--ink-soft);
    margin-top: .15rem;
  }
  /* Navigation as pills, and always visible — never behind a hamburger.
     Every page here is the point of the site: a reader who never notices the
     fees page may pay nine thousand euros. Hiding the menu to save space would
     trade the site's purpose for tidiness. */
  nav.site { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .45rem; }
  nav.site a {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--ink-soft);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: .5rem .8rem;
    transition: border-color .12s, color .12s, background .12s;
  }
  /* The five pages that protect a reader's money and time carry more weight.
     Everything stays visible: no toggle, nothing that moves, nothing to open
     twice. */
  nav.site a.key {
    color: var(--ink);
    font-weight: 600;
    background: var(--surface);
    border-color: var(--ink-soft);
  }
  nav.site a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  nav.site a[aria-current="page"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }
  @media (max-width: 26rem) {
    nav.site a, nav.site summary { font-size: .9375rem; padding: .5rem .7rem; }
  }
  h1 {
    font-size: 1.9rem;
    line-height: 1.2;
    letter-spacing: -.02em;
    text-wrap: balance;
    margin: 0 0 .6rem;
  }
  h2 {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 1.2rem;
    letter-spacing: -.01em;
    margin: 2.2rem 0 .6rem;
    text-wrap: balance;
  }
  p.standfirst { font-size: 1.15rem; color: var(--ink-soft); margin: 0 0 1.8rem; }
  a { color: var(--accent); text-underline-offset: 2px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  blockquote {
    margin: 1.4rem 0;
    padding: .9rem 1.1rem;
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: 2px;
  }
  blockquote p { margin: 0; }
  /* Images and diagrams. Every figure scales down to phone width and never
     forces the page to scroll sideways. */
  figure { margin: 1.8rem 0; }
  figure img, figure svg { width: 100%; height: auto; display: block; border-radius: 3px; }
  figure img { border: 1px solid var(--line); }
  figcaption {
    font-size: .9375rem;
    color: var(--ink-soft);
    margin-top: .5rem;
    line-height: 1.5;
  }
  figcaption .credit { opacity: .75; }
  /* Inline diagrams carry information rather than decoration, so they get the
     same visual weight as a table. */
  figure.diagram svg { background: var(--surface); border: 1px solid var(--line); }
  /* Numbered sequence. Built in HTML rather than SVG on purpose: text in a
     fixed-viewBox SVG shrinks to about 9px on a 375px phone, and this site is
     mostly read on phones. */
  ol.steps { list-style: none; padding: 0; margin: 1.8rem 0; }
  ol.steps li {
    position: relative;
    margin: 0 0 0 1.05rem;
    padding: 0 0 1.5rem 2.4rem;
    border-left: 2px solid var(--line);
  }
  ol.steps li:last-child { border-left-color: transparent; padding-bottom: 0; }
  ol.steps .n {
    position: absolute;
    left: -1.05rem;
    top: -.15rem;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: .95rem;
  }
  ol.steps li.arrive .n { background: var(--warn); }
  /* Citations. Numbered markers link to a graded reference list at the foot of
     the page. The grade matters as much as the number: a reader should be able
     to see at a glance whether a claim rests on a statute or on one person's
     account. */
  sup.cite { line-height: 0; font-size: .68em; }
  sup.cite a {
    text-decoration: none;
    font-weight: 700;
    padding: 0 .12em;
  }
  sup.cite a:hover { text-decoration: underline; }
  .refs { margin-top: 2.6rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .refs h2 { margin-top: 0; }
  .refs ol { padding-left: 1.4rem; margin: 0; }
  .refs li { font-size: 1rem; line-height: 1.55; margin-bottom: .85rem; }
  .refs li:target { background: var(--accent-soft); border-radius: 2px; }
  .badge {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: .65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    padding: .12rem .4rem;
    border-radius: 2px;
    margin-right: .35rem;
    vertical-align: .08em;
    white-space: nowrap;
  }
  .badge.primary   { background: var(--accent); color: var(--bg); }
  .badge.authority { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent); }
  .badge.secondary { background: var(--line); color: var(--ink-soft); }
  .badge.open      { background: var(--warn); color: var(--bg); }
  .badge.ours      { background: var(--warn-soft); color: var(--warn); border: 1px solid var(--warn); }
  /* Source links go straight to the primary document. nofollow because we cite
     these as evidence, not as endorsement. */
  a.src { font-weight: 600; white-space: nowrap; }
  /* Every link that leaves the site opens in a new tab, so say so before it is
     clicked. A reader on a phone in a second language should not have to wonder
     why the back button stopped working. The source links and the big template
     buttons already carry their own marker, so they are excluded. The target
     attribute this hangs off is set by the externalLinks transform in
     eleventy.config.js.

     Drawn as a background image rather than ::after content on purpose:
     generated content is read aloud by most screen readers, and "north east
     arrow" after every link is noise to someone who is already being told the
     link opens in a new window. currentColor keeps it right in both themes. */
  a[target="_blank"]:not(.src):not(.action)::after {
    content: "";
    display: inline-block;
    width: .62em;
    height: .62em;
    margin-left: .22em;
    vertical-align: baseline;
    opacity: .7;
    background-color: currentColor;
    -webkit-mask: var(--ext-arrow) no-repeat center / contain;
    mask: var(--ext-arrow) no-repeat center / contain;
  }
  .refs .nosrc { color: var(--ink-soft); font-style: italic; }
  /* The Europe comparison page carries its evidence inline rather than in a
     numbered list at the foot. Twenty-two countries would make a footnote list
     unreadable, and the whole argument of that page is that a claim is only
     worth as much as the source next to it — so the source sits next to it.

     Smaller and quieter than body text: a reader following the argument should
     be able to skim past these, and a reader checking us should find them
     without hunting. */
  .src-line, .open-line, .checked-line {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: .875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: .5rem 0;
  }
  /* The date a country was last read. Sits directly under its heading, because
     on this page "when did you check?" is part of the claim, not a footnote. */
  .checked-line {
    margin: -.2rem 0 1rem;
    font-weight: 600;
  }
  /* An open question gets the warning colour, not the quiet grey. On this site
     an unresolved item is the thing most likely to cost somebody money. */
  .open-line { color: var(--warn); }
  /* Prominent action links — used for the "copy this template" buttons, which
     are the main thing a reader comes to that page to do. */
  .actions { display: flex; flex-direction: column; gap: .7rem; margin: 1.5rem 0 1.2rem; }
  a.action {
    display: block;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    border-radius: 4px;
    padding: .85rem 1.1rem;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a.action:hover { filter: brightness(1.08); }
  a.action b { display: block; font-size: 1.0625rem; }
  a.action span { display: block; font-size: .8125rem; opacity: .85; margin-top: .1rem; }
  /* Imprint address block — § 5 DDG wants it "leicht erkennbar", so it gets to
     look like an address rather than a run-on paragraph. */
  .addr {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: .85rem 1rem;
    margin: 1rem 0 1.6rem;
    line-height: 1.75;
  }
  .addr .todo { color: var(--warn); font-weight: 700; }
  ol.steps .t { display: block; font-weight: 700; }
  ol.steps .d { display: block; color: var(--ink-soft); font-size: .9375rem; margin-top: .15rem; }
  .warn {
    margin: 1.4rem 0;
    padding: .9rem 1.1rem;
    background: var(--warn-soft);
    border-left: 3px solid var(--warn);
    border-radius: 2px;
  }
  .warn p:first-child { margin-top: 0; }
  .warn p:last-child { margin-bottom: 0; }
  table { border-collapse: collapse; width: 100%; font-size: 1rem; }
  .scroll { overflow-x: auto; margin: 1.4rem 0; }
  th, td { text-align: left; padding: .5rem .7rem; border-bottom: 1px solid var(--line); }
  th { font-family: system-ui, sans-serif; font-size: .875rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-soft); }
  /* Reader reports. Deliberately the weakest grade on the page: it is what
     people who wrote to us said happened to them, counted and dated — never one
     story dressed up as a fact. A statute always outranks it. */
  .badge.reports { background: var(--warn-soft); color: var(--warn); border: 1px dashed var(--warn); }
  /* The end-of-page invitation. It sits on every page a reader can land on,
     because the reader who has just been quoted 12 lakh is reading the fees
     page, not hunting for a contact link. */
  .invite {
    margin: 3rem 0 0;
    padding: 1.1rem 1.2rem;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 4px;
  }
  .invite h2 { margin: 0 0 .5rem; font-size: 1.1rem; }
  .invite p { margin: 0 0 .9rem; font-size: 1rem; }
  .invite a.action { display: inline-block; }
  footer.site {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  footer.site p { margin: 0 0 .5rem; }
  /* Devanagari needs more room than Latin at the same point size: the vowel
     signs sit above and below the consonant, and at 1.7 line-height they
     collide with the line beneath. Set through :lang() rather than a body
     class, so a Nepali quotation inside an English page gets it too.

     No webfont. Every Android phone and every Windows install since 8 ships a
     Devanagari face, and this site is read on cheap phones over slow
     connections — a 200KB font file to render text the device can already
     render is a bad trade. Nirmala UI is the Windows face, Noto the Android
     one, and the generic sans-serif at the end catches anything unusual. */
  :lang(ne) {
    font-family: "Noto Sans Devanagari", "Nirmala UI", Mangal, system-ui, sans-serif;
    line-height: 1.95;
  }
  :lang(ne) h1 { line-height: 1.45; letter-spacing: normal; }
  :lang(ne) h2 { line-height: 1.5; letter-spacing: normal; }
  /* Devanagari has no upper case, so the uppercasing used on English table
     headings does nothing but add letter-spacing to a script that does not
     want it. */
  :lang(ne) th { text-transform: none; letter-spacing: normal; font-size: .9375rem; }
  /* The language switch. Sits at the end of the navigation rather than up by
     the masthead: a reader who lands in the wrong language should find it where
     they are already looking. */
  nav.site a.lang {
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
    margin-left: auto;
  }
  @media (max-width: 26rem) {
    nav.site a.lang { margin-left: 0; }
  }
  /* The translation notice. Every Nepali page carries one, and it says which of
     three things is true: machine-translated and unchecked, checked by a Nepali
     speaker, or drifted behind an English page that has since been edited.

     Nobody sets this by hand. src/_data/translations.js works it out at build
     time by comparing a stored hash of the English against the English as it
     stands, so the notice cannot be left saying the wrong thing.

     The unchecked and drifted states get the warning colour. A parent deciding
     where to send their child is entitled to know how much weight the page
     will bear. */
  .tnote {
    margin: 0 0 1.8rem;
    padding: .85rem 1.1rem;
    border-radius: 2px;
    border-left: 3px solid var(--line);
    background: var(--surface);
    font-size: .9375rem;
    line-height: 1.8;
  }
  .tnote p { margin: 0 0 .4rem; }
  .tnote p:last-child { margin-bottom: 0; }
  .tnote.tnote-machine, .tnote.tnote-stale {
    background: var(--warn-soft);
    border-left-color: var(--warn);
  }
  .tnote.tnote-machine strong, .tnote.tnote-stale strong { color: var(--warn); }
  .tnote.tnote-ok {
    background: var(--accent-soft);
    border-left-color: var(--accent);
  }
</style>
</head>
<body>
<div class="wrap">

<header class="site">
  <a class="brand" href="{{ '/ne/' if L == 'ne' else '/' }}">{{ S.brand }}<span class="brand-sub">{{ S.brandSub }}</span></a>
  <nav class="site" aria-label="{{ S.navLabel }}">
    {%- for p in menu %}{% if p.data.primary %}
    <a href="{{ p.url }}" class="key"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.data.nav or p.data.title }}</a>
    {%- endif %}{% endfor %}
    {%- for p in menu %}{% if not p.data.primary %}
    <a href="{{ p.url }}"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.data.nav or p.data.title }}</a>
    {%- endif %}{% endfor %}
    {#- The switch only appears when there is somewhere to switch to. An
        untranslated page offers nothing rather than a link that 404s. -#}
    {%- if L == "ne" and tr and tr.enUrl %}
    <a class="lang" href="{{ tr.enUrl }}" lang="en" title="{{ S.otherLangTitle }}">{{ S.otherLang }}</a>
    {%- elif L == "en" and tr and tr.neUrl %}
    <a class="lang" href="{{ tr.neUrl }}" lang="ne" title="{{ S.otherLangTitle }}">{{ S.otherLang }}</a>
    {%- endif %}
  </nav>
</header>

<main>
  <h1>{{ title }}</h1>
  {%- if standfirst %}
  <p class="standfirst">{{ standfirst }}</p>
  {%- endif %}
  {%- if L == "ne" and tr %}
  <aside class="tnote {% if tr.stale %}tnote-stale{% elif tr.state == 'checked' %}tnote-ok{% else %}tnote-machine{% endif %}">
    {%- if tr.stale %}
    <p><strong>{{ ui.notice.staleH }}</strong></p>
    <p>{{ ui.notice.staleP }}</p>
    {%- elif tr.state == "checked" %}
    <p><strong>{{ ui.notice.checkedH }}</strong></p>
    <p>{{ ui.notice.checkedP }}{% if tr.checkedDate %} {{ ui.notice.checkedOn }} {{ tr.checkedDate }}.{% endif %}</p>
    {%- else %}
    <p><strong>{{ ui.notice.machineH }}</strong></p>
    <p>{{ ui.notice.machineP }}</p>
    {%- endif %}
    {%- if tr.enUrl %}
    <p><a href="{{ tr.enUrl }}" lang="en">{{ ui.notice.readEnglish }}</a></p>
    {%- endif %}
  </aside>
  {%- endif %}
  {{ content | safe }}
</main>

{%- if not noinvite %}
<aside class="invite">
  <h2>{{ S.inviteH }}</h2>
  <p>{{ S.inviteP1 }}</p>
  <p>{{ S.inviteP2 }}</p>
  <a class="action" href="{{ '/ne/contact/' if L == 'ne' else '/contact/' }}"><b>{{ S.inviteCtaB }}</b><span>{{ S.inviteCtaS }}</span></a>
</aside>
{%- endif %}

<footer class="site">
  <p><strong>{{ S.footAdviceB }}</strong> {{ S.footAdvice }}
  <a href="/impressum/" lang="en">{{ S.footAdviceLink }}</a>.</p>
  <p>{{ S.footIndependent }}</p>
  <p><strong>{{ S.footWrongB }}</strong> {{ S.footWrong1 }}
  <a href="mailto:info@ausbildungfacts.org">info@ausbildungfacts.org</a> {{ S.footWrong2 }}
  <a href="{{ '/ne/contact/' if L == 'ne' else '/contact/' }}">{{ S.footWrongForm }}</a>{{ S.footWrong3 }}</p>
  <p>{{ S.footReviewed }} {{ reviewed or "August 2026" }} &middot;
     <a href="/impressum/" lang="en">{{ S.footImprint }}</a> &middot;
     <a href="/datenschutz/" lang="en">{{ S.footPrivacy }}</a></p>
</footer>

</div>
</body>
</html>
