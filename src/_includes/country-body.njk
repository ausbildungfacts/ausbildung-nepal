{#- The body of one detailed country entry on /europe/.

    Pulled out into an include because the three groups on that page — training
    routes, the countries people actually go to, and the short entries — print
    the same fields and must never drift apart. One template, one shape, and a
    missing field is missing everywhere rather than in one place nobody checks.

    Expects `c`, one entry from europe.json's `countries` array, from the
    enclosing for-loop. Nunjucks include inherits the caller's context.

    Several fields are either a plain string or an object of
    {status, text} — the object form is used wherever the honest answer is "we
    have not checked this". `{% if x.text %}` distinguishes them: a string has
    no `.text`.

    LABELS come from ui.json rather than being written here, because this
    include renders on the Nepali mirror too. The VALUES come from europe.json
    and fall back to English until translated (see src/_data/europeNe.js), so
    the labels are what a Nepali reader navigates the table by and they are
    worth having in Nepali even when the cell beside them is not yet.

    `lang` is page data, set for the whole folder by src/ne/ne.json. The `L`
    that base.njk sets is not visible here: the page renders before the layout
    wraps it. -#}

{%- set CL = ui.country[lang or "en"] %}

{%- if c.qualification and c.qualification.note %}
{{ c.qualification.note }}
{%- endif %}

{%- if c.routes and c.routes.length %}

**{{ CL.waysIn }}**

{% for r in c.routes %}
- {{ r }}
{%- endfor %}
{%- endif %}

<div class="scroll">

| | |
| --- | --- |
{%- if c.language %}
| **{{ CL.language }}** | {% if c.language.text %}{{ c.language.text }}{% else %}{{ c.language }}{% endif %} |
{%- endif %}
{%- if c.sectors %}
| **{{ CL.sectors }}** | {% if c.sectors.text %}{{ c.sectors.text }}{% else %}{{ c.sectors }}{% endif %} |
{%- endif %}
{%- if c.pay %}
| **{{ CL.pay }}** | {{ c.pay.text }} |
{%- endif %}
{%- if c.family %}
| **{{ CL.family }}** | {{ c.family.text }} |
{%- endif %}
{%- if c.permanent %}
| **{{ CL.permanent }}** | {{ c.permanent.text }} |
{%- endif %}
{%- if c.apply_where %}
| **{{ CL.applyWhere }}** | {% if c.apply_where.text %}{{ c.apply_where.text }}{% else %}{{ c.apply_where }}{% endif %} |
{%- endif %}
| **{{ CL.rights }}** | {% if c.single_permit.status == "carried" %}{{ CL.rightsYes }}{% elif c.single_permit.status == "carved_out" %}{{ CL.rightsNo }}{% elif c.single_permit.status == "mixed" %}{{ CL.rightsMixed }}{% elif c.single_permit.status == "not_applicable" %}{{ CL.rightsOutside }}{% else %}{{ CL.rightsUnresolved }}{% endif %}{% if c.single_permit.note %}. {{ c.single_permit.note }}{% endif %} |

</div>

{%- if c.money %}

{{ CL.moneyLead }} **€{{ c.money.min_wage_eur | num }} {{ CL.moneyGross }}**
{{ CL.moneyAsAt }} {{ c.money.as_of }} {{ CL.moneyWorth }}
{{ c.money.min_wage_pps | num }} {{ CL.moneyPps }}
{%- if c.money.note %}

{{ c.money.note }}
{%- endif %}
{%- endif %}

{%- if c.changes and c.changes.length %}

**{{ CL.changed }}**

{% for ch in c.changes %}
- {{ ch }}
{%- endfor %}
{%- endif %}

{%- if c.scams and c.scams.length %}

<div class="warn">

**{{ CL.goesWrong }}**

{% for s in c.scams %}
- {{ s }}
{%- endfor %}

</div>
{%- endif %}

{%- if c.honest_verdict %}

<blockquote>

{{ CL.verdict }} {{ c.honest_verdict }}

</blockquote>
{%- endif %}

{%- if c.more_on_this_site and c.more_on_this_site.length %}

**{{ CL.moreHere }}**
{% for m in c.more_on_this_site %}
- [{{ m.label }}]({{ m.url }})
{%- endfor %}
{%- endif %}

{%- if c.open and c.open.length %}

<p class="open-line"><span class="badge open">{{ CL.openBadge }}</span> {{ CL.openLead }}
{{ c.name }}{{ CL.openTail }}</p>

{% for o in c.open %}
- {{ o }}
{%- endfor %}
{%- endif %}

{%- if c.sources and c.sources.length %}

**{{ CL.sourcesFor }} {{ c.name }}:**
{% for s in c.sources %}

<p class="src-line"><span class="badge {% if s.status == 'primary' %}primary{% elif s.status == 'official' %}authority{% else %}secondary{% endif %}">{{ ui.grade[lang or "en"][s.status] or s.status }}</span>
{{ s.label }} — <a class="src" href="{{ s.url }}">{{ CL.srcWord }}</a>{{ CL.stop }} {{ CL.checkedLabel }} {{ s.checked }}{{ CL.stop }}</p>
{%- endfor %}
{%- endif %}
